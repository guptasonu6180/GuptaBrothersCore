@{
    var title = ViewBag.Title as string ?? "Gupta Brothers - Enterprise Shipping & Invoicing";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>@title</title>
    <link rel="icon" href="~/images/gupta-brothers-emblem.svg" type="image/svg+xml">
    <link rel="alternate icon" href="~/images/favicon.ico" type="image/x-icon">

    <!-- Bootstrap 5 & Icons -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />

    <!-- Google Fonts: Space Grotesk & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">

    <!-- Gupta Brothers Enterprise Stylesheets -->
    <link href="~/css/gupta-brothers.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/shipping-label.css" rel="stylesheet" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Futuristic Cyber Navigation Bar -->
    <header class="app-top-header">
        <div class="container-fluid d-flex flex-wrap align-items-center justify-content-between p-0">
            <!-- Gupta Brothers Brand Logo & Identity -->
            <a asp-controller="ShippingLabel" asp-action="Index" class="brand-container" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Gupta Brothers - Return to Home Dashboard">
                <img src="~/images/gupta-brothers-emblem.svg" alt="Gupta Brothers" class="brand-logo-img" />
                <div>
                    <div class="brand-title-text">
                        Gupta Brothers
                        <span class="cyber-badge">Enterprise v2.6</span>
                    </div>
                    <div class="brand-subtitle-text">
                        Smart Thermal Shipping Labels (Half Format) • Vector QR Engine
                    </div>
                </div>
            </a>

            <!-- Navigation Links with Small Buttons and Hover Tooltips -->
            <nav class="nav-links my-2 my-lg-0">
                <a asp-controller="ShippingLabel" asp-action="Index" class="nav-link-cyber active" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Overview and shipping label records">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a href="javascript:void(0);" onclick="$('#uploadModal').modal('show');" class="nav-link-cyber" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Upload Excel/CSV file to bulk import labels">
                    <i class="bi bi-file-earmark-arrow-up"></i> Import Excel
                </a>
                <a asp-controller="ShippingLabel" asp-action="DownloadTemplate" class="nav-link-cyber" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Download official Excel template with sample orders">
                    <i class="bi bi-file-earmark-excel"></i> Sample Template
                </a>
                <a asp-controller="ShippingLabel" asp-action="ExportExcel" class="nav-link-cyber" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Export all active shipping records to Excel">
                    <i class="bi bi-file-earmark-arrow-down"></i> Export Excel
                </a>
                <a asp-controller="ShippingLabel" asp-action="Print" target="_blank" class="nav-link-cyber" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Print all thermal shipping labels in batch">
                    <i class="bi bi-printer"></i> Print All
                </a>
                <a asp-controller="ShippingLabel" asp-action="Settings" class="nav-link-cyber" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Configure default seller & return addresses">
                    <i class="bi bi-gear-wide-connected"></i> Settings
                </a>
            </nav>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="main-container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show alert-gb-success d-flex align-items-center mb-3 py-2 px-3" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div class="fw-semibold text-dark small">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show alert-gb-danger d-flex align-items-center mb-3 py-2 px-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div class="fw-semibold text-dark small">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Upload Excel / CSV Modal -->
    <div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <form asp-controller="ShippingLabel" asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="modal-header text-white bg-dark py-3">
                        <div class="d-flex align-items-center gap-2">
                            <img src="~/images/gupta-brothers-emblem.svg" alt="GB" width="26" height="26" />
                            <h6 class="modal-title fw-bold mb-0" id="uploadModalLabel">
                                Import Excel / CSV Orders
                            </h6>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="upload-dropzone-box">
                            <i class="bi bi-cloud-arrow-up-fill display-5 text-primary d-block mb-2"></i>
                            <h6 class="fw-bold mb-1">Select Your Spreadsheet File (.xlsx, .csv)</h6>
                            <p class="text-muted small mb-3">All barcodes, QR codes, and routing labels will generate automatically.</p>
                            <input type="file" name="excelFile" class="form-control form-control-sm" accept=".xlsx,.xls,.csv" required />
                        </div>

                        <div class="template-hint-card">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-file-earmark-spreadsheet text-success fs-5 mt-1"></i>
                                <div class="small text-secondary">
                                    <strong>Need the fixed 14-column template?</strong><br />
                                    Download the <a asp-controller="ShippingLabel" asp-action="DownloadTemplate" class="fw-bold text-success text-decoration-none" data-bs-toggle="tooltip" title="Download fixed 14-column sample spreadsheet">Gupta Brothers Sample Template</a> with pre-filled orders.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0 py-2 px-3">
                        <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-cyber-primary btn-sm px-3" data-bs-toggle="tooltip" title="Upload and process spreadsheet">
                            <i class="bi bi-lightning-charge me-1"></i> Process &amp; Generate Labels
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global Bootstrap Tooltips Initializer
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl, { trigger: 'hover' });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
